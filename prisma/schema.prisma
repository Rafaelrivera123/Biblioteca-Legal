generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum Role {
  admin
  user
}
enum LegalUpdateType {
  REFORM
  NEW_LAW
  REPEAL
}
enum LegalUpdateStatus {
  draft
  published
}
enum GacetaStatus {
  pending
  processing
  processed
  failed
}
model Gaceta {
  id             String       @id @default(cuid())
  number         String       @unique
  fileName       String
  // Desde 2026-07-29 el PDF se sube directo del navegador a Vercel Blob
  // (ver /api/gacetas/upload y UploadGacetasModal) y solo guardamos la URL
  // acá. Antes se guardaba el PDF completo como bytea en Neon vía Server
  // Action, pero Vercel impone un límite DURO de 4.5MB en el body de
  // request/response de cualquier Function — un límite de la plataforma,
  // no de Next.js, así que subir `serverActions.bodySizeLimit` en
  // next.config.mjs nunca lo evitaba. Cualquier Gaceta de más de ~4.5MB
  // fallaba siempre al subirla, sin importar el tamaño configurado ahí.
  // Con la subida directa a Blob el archivo nunca pasa por una Function,
  // así que ya no hay tope de tamaño real.
  pdfUrl         String?
  // Se conserva solo como fallback de lectura para Gacetas subidas antes
  // de este cambio. Ninguna Gaceta nueva vuelve a usar este campo.
  pdfData        Bytes?
  fileAvailable  Boolean      @default(true)
  status         GacetaStatus @default(pending)
  updatesCreated Int          @default(0)
  errorMessage   String?
  // Resumen corto (máx. ~40 palabras) de qué contiene esta Gaceta, para
  // mostrar en la tarjeta de /gacetas. Se genera automáticamente al
  // procesar la Gaceta (ver gaceta-processor.ts) a partir de las reformas,
  // leyes nuevas y derogaciones detectadas, pero el admin puede corregirlo
  // a mano desde /dashboard/gacetas (ver updateGacetaDescription).
  description    String?
  uploadedAt     DateTime     @default(now())
  processedAt    DateTime?
}
model User {
  id               String    @id @default(cuid())
  // Auth.js OAuth adapter writes `name`; we also keep first/last for the app.
  name             String?
  first_name       String    @default("")
  last_name        String    @default("")
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  phone            String?
  dateOfBirth      DateTime?
  gender           String?
  address          String?
  country          String?
  career           String?
  role             Role      @default(user)
  // Optional so Google/Facebook users can register without a password.
  password         String?
  paddleCustomerId String?
  accounts         Account[]
  sessions         Session[]
  articleMeta      UserArticleMeta[]
  isActive         Boolean   @default(false)
  watchLists       WatchLists[]
  devices          Device[]
  userSubscription UserSubscription?
  companyId        String?
  company          Company?  @relation(fields: [companyId], references: [id])
  chatUsages       ChatUsage[]
  onboardingCompleted Boolean @default(false)
  // false for new OAuth users until they confirm name/email on /sign-up/complete
  accountCompleted Boolean   @default(true)
  // Lifetime free AI chat messages used (server-side quota for free users)
  freeChatUsed     Int       @default(0)
  // Nurture drip: 0=welcome only, 1=tip sent, 2=offer sent
  nurtureEmailStep Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}
model UserQue {
  id         String   @id @default(cuid())
  first_name String
  last_name  String
  email      String   @unique
  customerId String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
model Device {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId  String
  userAgent String?
  ipAddress String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, deviceId])
}
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String
  expires    DateTime
  @@unique([identifier, token])
}
model ResetReq {
  id            String   @id @default(cuid())
  email         String
  otp           Int
  isOtpVerified Boolean  @default(false)
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
model NewsLetter {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Category {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Document {
  id                String            @id @default(cuid())
  name              String
  slug              String?           @unique
  oldSlug           String?           @unique
  short_description String
  law_number        String
  published         Boolean           @default(true)
  viewCount         Int               @default(0)
  articleMeta       UserArticleMeta[]
  watchLists        WatchLists[]
  categories        DocumentCategory[]
  sections          Section[]
  legalUpdatePosts  LegalUpdatePost[]
  publishedAt       DateTime          @default(now())
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}
model DocumentCategory {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  categoryId String
  name       String
  createdAt  DateTime @default(now())
}
model WatchLists {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}
model Section {
  id         String    @id @default(cuid())
  title      String
  documentId String
  document   Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chapters   Chapter[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}
model Chapter {
  id        String    @id @default(cuid())
  title     String
  sectionId String
  section   Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  articles  Article[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
model Article {
  id               String            @id @default(cuid())
  content          String
  contentPlainText String            @default("")
  aiSummary        String?
  embedding        Unsupported("vector(768)")?
  articleNumber    Int
  articleLabel     String?
  viewCount        Int               @default(0)
  chapterId        String
  chapter          Chapter           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  userMeta         UserArticleMeta[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}
model UserArticleMeta {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  articleId     String
  article       Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  selectedColor String?
  isBookmarked  Boolean  @default(false)
  comment       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@unique([userId, articleId])
}
model Company {
  id            String                @id @default(cuid())
  name          String
  location      String
  contact_email String
  overview      String
  employees     User[]
  subscriptions CompanySubscription[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}
model CompanySubscription {
  id                 String   @id @default(cuid())
  companyId          String   @unique
  company            Company  @relation(fields: [companyId], references: [id])
  txn_id             String
  isActive           Boolean  @default(true)
  currentPeriodStart DateTime @default(now())
  currentPeriodEnd   DateTime
}
model UserSubscription {
  id                 String   @id @default(cuid())
  userId             String   @unique
  txn_id             String   @unique
  sub_id             String   @unique
  isActive           Boolean  @default(false)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}
model PrivacyPolicy {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model TermsOfService {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model RefundPolicy {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Setting {
  id           String   @id @default(cuid())
  adminId      String   @unique
  siteName     String?
  supportEmail String?  @unique
  description  String?
  keywords     String[]
  price        Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
model ChatUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, date])
}
model BatchJob {
  id          String   @id @default(cuid())
  batchId     String   @unique
  status      String   @default("pending")
  totalItems  Int      @default(0)
  processed   Int      @default(0)
  failed      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model LegalUpdatePost {
  id                String            @id @default(cuid())
  slug              String            @unique
  title             String
  summary           String
  content           String
  changesData       Json?
  type              LegalUpdateType
  status            LegalUpdateStatus @default(draft)
  gacetaNumber      String?
  legalSource       String?
  relatedDocumentId String?
  relatedDocument   Document?         @relation(fields: [relatedDocumentId], references: [id])
  sourceWeek        DateTime          @default(now())
  publishedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}
// Registra búsquedas que no devolvieron resultados en /api/search, para
// saber qué palabras clave o frases la gente busca y no encuentra, y
// priorizar sobre datos reales en vez de adivinar.
model SearchLog {
  id           String   @id @default(cuid())
  query        String
  resultsCount Int      @default(0)
  source       String   @default("literal")
  createdAt    DateTime @default(now())
  @@index([createdAt])
}
