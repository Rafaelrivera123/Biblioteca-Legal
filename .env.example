# Database (Neon Postgres)
DATABASE_URL=

# Auth (NextAuth v5)
AUTH_SECRET=
AUTH_URL=https://your-domain.com
ADMIN_EMAIL=admin@example.com
ADMIN_UNLIMITED_EMAILS=admin@example.com

# OAuth — Google (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# OAuth — Facebook (https://developers.facebook.com/apps)
AUTH_FACEBOOK_ID=
AUTH_FACEBOOK_SECRET=

# Email (SuperSend TX)
SUPERSENDTX_API_KEY=

# Payments (Paddle)
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_TOKEN=
# Personal monthly price ($5.99/mo)
NEXT_PUBLIC_PRICE_ID=
# Personal annual price — 30% off 12× monthly ($50.32/yr). Create in Paddle dashboard.
NEXT_PUBLIC_ANNUAL_PRICE_ID=

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Vercel Blob (Gaceta PDFs, avatars, temp uploads)
BLOB_READ_WRITE_TOKEN=

# Cron / batch jobs (Vercel cron + admin tools)
CRON_SECRET=

# Analytics
GOOGLE_ANALYTICS_ID=

# Node
NODE_ENV=development
